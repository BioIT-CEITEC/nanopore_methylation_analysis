{
  "workflow_description": {
    "name":"nanopore_methylation_analysis",
    "version": 1.0,
    "label":"Methylation analysis",
    "type":"methylation_analysis",
    "inputs":[
      "methylation/{sample}/*"
    ],
    "outputs":[
      "methylation/{sample}/{sample}_filtered*",
      "methylation/{sample}/{sample}*100kb.bed",
      "methylation/{sample}/{sample}_genes-stats.tsv", 
      "methylation/{sample}/{sample}_genes-stats_filtered.tsv",
      "methylation/chrom.sizes",
      "methylation/chr_windows.bed"
    ],
    "run_parameters": {
      "cpu": 30,
      "memory": 128
    }
  },
  "general_params": [
  "entity_name",
  "sample_name"
  ],
  "requested_params": [
    "organism", 
    "assembly",
    "5mC_methylation", 
    "6mA_methylation"
  ],
  "gui_params" : {
  }
}

