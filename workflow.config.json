{
  "workflow_description": {
    "name":"nanopore_methylation_analysis",
    "version": 1.0,
    "label":"Methylation analysis",
    "type":"methylation_analysis",
    "inputs":[
      "methylation/{sample}/*"
    ],
    "outputs":[
      "methylation/*"
    ],
    "run_parameters": {
      "cpu": 30,
      "memory": 128
    }
  },
  "general_params": [
  "entity_name",
  "sample_name"
  ],
  "requested_params": [
    "organism", 
    "assembly",
    "5mC_methylation", 
    "6mA_methylation"
  ],
  "gui_params" : {
    "detailed" : {
      "windows_size": {
        "label": "Size of windows for mean methylations, default 100kb",
        "type": "int",
        "default": 100000
    },
      "compare_genes": {
        "label": "Compare genes, needed gtf file",
        "type": "bool",
        "default": false
    }
    }

  }
}

